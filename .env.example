# Supabase (KTP Blog project)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase (KTP Portal project, kept separate from the public blog)
NEXT_PUBLIC_PORTAL_SUPABASE_URL=
NEXT_PUBLIC_PORTAL_SUPABASE_ANON_KEY=

# The production deployment also has a tracked .env.production fallback with
# only the two public-blog NEXT_PUBLIC values. Browser anon keys are public by
# design. Never put a service-role key in a NEXT_PUBLIC variable.

# Server-side chatbot
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite

# Contact form fallback and analytics
RESEND_API_KEY=
NEXT_PUBLIC_GA_ID=

# Cloudinary upload scripts (server-side/local only)
CLOUDINARY_CLOUD_NAME=dha44tosd
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Legacy/portal integrations (only if those features are reactivated)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
